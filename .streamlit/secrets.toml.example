# Copy this file to .streamlit/secrets.toml locally, OR paste its contents
# into Streamlit Cloud -> App -> Settings -> Secrets.
#
# This enables permanent data storage on Streamlit Cloud by committing
# data/loan_data.json back to your GitHub repo whenever you add an entry.

[github]
# Create a fine-grained Personal Access Token at:
#   https://github.com/settings/tokens?type=beta
# Scope it to ONLY the Home-Loan-Tracker repo, with:
#   Repository permissions -> Contents: Read and write
token = "PASTE_YOUR_GITHUB_TOKEN_HERE"
repo = "starksteve/Home-Loan-Tracker"
path = "data/loan_data.json"
branch = "main"
